<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.whisper.dictation.server</string>
    
    <key>ProgramArguments</key>
    <array>
        <string>/Users/USER_HOME/MyProjects/whisper_hotkey/venv/bin/python3</string>
        <string>/Users/USER_HOME/MyProjects/whisper_hotkey/whisper_server.py</string>
        <string>base</string>
        <string>en</string>
    </array>
    
    <key>RunAtLoad</key>
    <true/>
    
    <key>KeepAlive</key>
    <true/>
    
    <key>StandardOutPath</key>
    <string>/tmp/whisper_server.log</string>
    
    <key>StandardErrorPath</key>
    <string>/tmp/whisper_server.log</string>
    
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
